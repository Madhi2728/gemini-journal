# Server secrets. Never committed -- set these in the Render dashboard.

# 'env' uses the host's encrypted secret store (free tier).
# 'gcp' uses Google Cloud Secret Manager (needs billing enabled).
SECRET_PROVIDER=env

# Only read when SECRET_PROVIDER=env.
GEMINI_API_KEY=

# Base64 of the Firebase service account JSON. Generate with:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccount.json"))
FIREBASE_SERVICE_ACCOUNT=

# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=https://YOUR_PROJECT.web.app

GEMINI_MODEL=gemini-3.7-flash
