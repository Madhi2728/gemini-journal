# Firebase Web SDK config.
#
# These are NOT secrets. They identify your project to Google and are meant to
# ship inside client JavaScript. Access control comes from Firebase Auth plus
# Firestore Security Rules, not from hiding these values.
#
# The Gemini API key is a real secret. It never appears in this file, in the
# client bundle, or anywhere in this repository. It lives in Google Cloud
# Secret Manager and is read at runtime by the backend only.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE=http://127.0.0.1:5001/YOUR_PROJECT/us-central1/api
